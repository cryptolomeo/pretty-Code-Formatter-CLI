#!/bin/bash
set -e

MODE=""
CHECK=false
STAGED=false

# --------- PARSEO DE ARGUMENTOS ---------
for arg in "$@"; do
  case $arg in
    tabs|spaces)
      MODE=$arg
      ;;
    --check)
      CHECK=true
      ;;
    --staged)
      STAGED=true
      ;;
    *)
      echo "❌ Argumento desconocido: $arg"
      echo "Uso: pretty [tabs|spaces] [--check] [--staged]"
      exit 1
      ;;
  esac
done

# 🔧 CAMBIO: Validación explícita del modo
if [[ "$MODE" != "tabs" && "$MODE" != "spaces" ]]; then
  echo "❌ Debes especificar 'tabs' o 'spaces'"
  echo "Uso: pretty [tabs|spaces] [--check] [--staged]"
  exit 1
fi

# --------- DEPENDENCIAS ---------
if ! command -v npx &> /dev/null; then
  echo "❌ npx no está instalado. Instala Node.js."
  exit 1
fi

# --------- VALIDACIÓN GIT ---------
# 🔧 CAMBIO: Validar repo git si se usa --staged
if [ "$STAGED" = true ]; then
  if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "❌ --staged requiere un repositorio git"
    exit 1
  fi
fi

# --------- CONFIG ---------
if [ "$MODE" == "tabs" ]; then
  INDENT_STYLE="tab"
  INDENT_SIZE=4
  MSG="tabs (ancho visual 4)"
else
  INDENT_STYLE="space"
  INDENT_SIZE=2
  MSG="2 espacios"
fi

echo "🔧 Modo: $MSG"

# --------- EDITORCONFIG ---------
# 🔧 CAMBIO: Aviso claro (sin interacción para no romper CI)
if [ -f .editorconfig ]; then
  echo "⚠️ .editorconfig ya existe y será sobrescrito"
fi

cat > .editorconfig << EOF
root = true

[*]
indent_style = $INDENT_STYLE
indent_size = $INDENT_SIZE
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2
EOF

# --------- ARCHIVOS ---------
# 🔧 CAMBIO: Uso de array para evitar problemas con espacios en nombres de archivo
if [ "$STAGED" = true ]; then
  mapfile -t FILES < <(git diff --cached --name-only --diff-filter=ACM)
  echo "📦 Solo archivos staged"
else
  FILES=(".")
fi

# --------- PRETTIER ---------
echo "🎨 Ejecutando Prettier..."

# 🔧 CAMBIO: Uso de array correctamente expandido
if [ "$CHECK" = true ]; then
  npx --yes prettier --check "${FILES[@]}"
else
  npx --yes prettier --write "${FILES[@]}"
fi

echo "✅ Completado"