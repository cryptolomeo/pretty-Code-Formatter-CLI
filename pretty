#!/bin/bash
set -e

MODE=""
CHECK=false
STAGED=false
FORCE=false

# --------- PARSEO DE ARGUMENTOS ---------
for arg in "$@"; do
  case $arg in
    tabs|spaces)
      MODE=$arg
      ;;
    --check)
      CHECK=true
      ;;
    --staged)
      STAGED=true
      ;;
    --force)  # 🔧 CAMBIO
      FORCE=true
      ;;
    *)
      echo "❌ Argumento desconocido: $arg"
      echo "Uso: pretty [tabs|spaces] [--check] [--staged] [--force]"
      exit 1
      ;;
  esac
done

# --------- VALIDACIÓN DE MODO ---------
if [[ "$MODE" != "tabs" && "$MODE" != "spaces" ]]; then
  echo "❌ Debes especificar 'tabs' o 'spaces'"
  echo "Uso: pretty [tabs|spaces] [--check] [--staged] [--force]"
  exit 1
fi

# --------- DEPENDENCIAS ---------
if ! command -v npx &> /dev/null; then
  echo "❌ npx no está instalado. Instala Node.js."
  exit 1
fi

# --------- VALIDACIÓN GIT ---------
if [ "$STAGED" = true ]; then
  if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "❌ --staged requiere un repositorio git"
    exit 1
  fi
fi

# --------- CONFIG ---------
if [ "$MODE" == "tabs" ]; then
  INDENT_STYLE="tab"
  INDENT_SIZE=4
  MSG="tabs (ancho visual 4)"
else
  INDENT_STYLE="space"
  INDENT_SIZE=2
  MSG="2 espacios"
fi

echo "🔧 Modo: $MSG"

# --------- EDITORCONFIG ---------
# 🔧 CAMBIO: control con --force
if [ -f .editorconfig ]; then
  if [ "$FORCE" = false ]; then
    echo "⚠️ .editorconfig ya existe"
    echo "💡 Usa --force para sobrescribirlo"
  else
    echo "⚠️ Sobrescribiendo .editorconfig (--force)"
  fi
fi

# 🔧 CAMBIO: solo escribir si no existe o si --force
if [ ! -f .editorconfig ] || [ "$FORCE" = true ]; then
  cat > .editorconfig << EOF
root = true

[*]
indent_style = $INDENT_STYLE
indent_size = $INDENT_SIZE
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2
EOF
else
  echo "⏭️ Se mantiene el .editorconfig existente"
fi

# --------- ARCHIVOS ---------
if [ "$STAGED" = true ]; then
  mapfile -t FILES < <(git diff --cached --name-only --diff-filter=ACM)
  echo "📦 Solo archivos staged"
else
  FILES=(".")
fi

# 🔧 CAMBIO: evitar ejecutar si no hay archivos staged
if [ "$STAGED" = true ] && [ ${#FILES[@]} -eq 0 ]; then
  echo "📭 No hay archivos staged para procesar"
  exit 0
fi

# --------- PRETTIER ---------
echo "🎨 Ejecutando Prettier..."

if [ "$CHECK" = true ]; then
  npx --yes prettier --check "${FILES[@]}"
else
  npx --yes prettier --write "${FILES[@]}"
fi

echo "✅ Completado"
